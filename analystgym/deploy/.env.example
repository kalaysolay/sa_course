# Пример окружения. Скопировать в deploy/.env и заполнить настоящими значениями.
# Сам .env в git не коммитим (см. .gitignore). Пароли и секреты сгенерировать,
# не "12345" (JWT: openssl rand -hex 32).
#
# Каждая переменная ниже привязана к application.yml — пустые значения
# означают «выключено/по умолчанию», кроме помеченных (обязательно).

# --- База (обязательно; compose сам собирает URL внутри сети) ---
POSTGRES_USER=analystgym
POSTGRES_PASSWORD=change-me-before-prod

# --- Сайт и куки ---
# Внешний базовый URL (ссылки в письмах) и домен для Caddy.
APP_SITE_BASE_URL=https://analystgym.ru
APP_DOMAIN=analystgym.ru
# За Caddy с https куки обязаны быть Secure, иначе браузер их не отдаст.
APP_COOKIES_SECURE=true

# --- JWT (обязательно, минимум 32 символа; ротация вышибает все сессии) ---
APP_JWT_SECRET=change-me-to-32-plus-chars-secret-before-prod

# --- Создание первого администратора отдельной командой --bootstrap-admin ---
# Передать только на время команды; не держать bootstrap-пароль в окружении сервера.
# APP_BOOTSTRAP_ADMIN_EMAIL=
# APP_BOOTSTRAP_ADMIN_PASSWORD=
# APP_BOOTSTRAP_ADMIN_NAME=Администратор

# --- Google-вход (без ключей — выключен, кнопка показывает заглушку) ---
APP_GOOGLE_ENABLED=false
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_SECRET=

# --- Ревью: mock (детерминированный) или llm (модели + фолбэк) ---
REVIEW_ENGINE=mock
REVIEW_LLM_PRIMARY=deepseek
REVIEW_LLM_FALLBACK=glm
# Ключи моделей читаются из окружения по именам из таблицы провайдеров.
DEEPSEEK_API_KEY=
GLM_API_KEY=

# --- ЮKassa (прод): без обоих ключей приложение работает на fake-провайдере ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Подпись вебхуков кассы (настроить в кабинете ЮKassa тот же секрет).
BILLING_WEBHOOK_SECRET=change-me-before-prod
# Тестовое подтверждение fake-платежей: в проде false.
BILLING_FAKE_ENABLED=false

# --- Почта (транзакционная: сброс пароля). Без флага — письма в лог ---
APP_MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
APP_MAIL_FROM=noreply@analystgym.ru

# --- Лимиты API (по умолчанию хватает; крутить при абузе) ---
RATELIMIT_LOGIN_PER_MIN=20
RATELIMIT_REGISTER_PER_MIN=5
RATELIMIT_RESET_PER_MIN=5
RATELIMIT_SUBMIT_PER_MIN=10
RATELIMIT_ASSESSMENT_PER_MIN=5
RATELIMIT_COMPLAINTS_PER_MIN=10
