# Пример окружения. Скопировать в deploy/.env и заполнить настоящими значениями.
# Сам .env в git не коммитим (см. .gitignore). Пароли и секреты сгенерировать,
# не "12345" (JWT: openssl rand -hex 32).
#
# Значения читаются compose/Caddy/application.yml. Пустым оставляйте только
# необязательные ключи подключений; числовым лимитам нужны явные значения.

# --- База (обязательно; compose сам собирает URL внутри сети) ---
POSTGRES_USER=analystgym
POSTGRES_PASSWORD=change-me-before-prod

# --- Сайт и куки ---
# Внешний базовый URL (ссылки в письмах) и домен для Caddy.
APP_SITE_BASE_URL=https://analystgym.ru
APP_DOMAIN=analystgym.ru
# За Caddy используем Secure-куки; compose принудительно задаёт true.
# Локальный HTTP без Caddy запускайте через bootRun (см. DEPLOY.md).
APP_COOKIES_SECURE=true

# --- JWT (обязательно, минимум 32 символа; ротация вышибает все сессии) ---
APP_JWT_SECRET=change-me-to-32-plus-chars-secret-before-prod

# --- Создание первого администратора отдельной командой --bootstrap-admin ---
# Передать только на время команды; не держать bootstrap-пароль в окружении сервера.
# APP_BOOTSTRAP_ADMIN_EMAIL=
# APP_BOOTSTRAP_ADMIN_PASSWORD=
# APP_BOOTSTRAP_ADMIN_NAME=Администратор

# --- Google-вход (без ключей — выключен, кнопка показывает заглушку) ---
APP_GOOGLE_ENABLED=false
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_SECRET=

# --- Ревью: mock (демонстрация до 45/100) или llm (провайдеры из БД) ---
REVIEW_ENGINE=mock
REVIEW_LLM_PRIMARY=deepseek
REVIEW_LLM_FALLBACK=glm
# Ключи моделей читаются из окружения по именам из таблицы провайдеров.
DEEPSEEK_API_KEY=
GLM_API_KEY=
REVIEW_MAX_SOLUTION_CHARS=20000
REVIEW_MAX_INPUT_BYTES=64000
REVIEW_MAX_OUTPUT_TOKENS=2000
REVIEW_TOKEN_BUDGET=160000
REVIEW_MAX_CALLS=6
REVIEW_QUEUE_ENABLED=true
REVIEW_WORKERS=2
REVIEW_LEASE_SECONDS=30
REVIEW_HEARTBEAT_MS=1000
REVIEW_POLL_MS=500
REVIEW_MAX_TRIES=3
REVIEW_RETRY_SECONDS=2
# --- Диагностика и повторные проверки жалоб ---
ASSESSMENT_GUEST_DAYS=7
QUALITY_RECHECK_ENABLED=true
QUALITY_RECHECK_POLL_MS=2000
# --- Очередь писем о ревью и жалобах (кабинет доступен и без SMTP) ---
NOTIFICATION_MAX_TRIES=5
NOTIFICATION_RETRY_SECONDS=30
NOTIFICATION_LEASE_SECONDS=120
NOTIFICATION_POLL_MS=1000

# --- Оплата: пока не подключаем к запуску MVP; без ключей выбирается fake ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Секрет внутреннего webhook-контракта приложения; это не готовая настройка
# нативных уведомлений ЮKassa. Подключение платёжного провайдера — отдельная работа.
BILLING_WEBHOOK_SECRET=change-me-before-prod
# Тестовое подтверждение fake-платежей: в проде false.
BILLING_FAKE_ENABLED=false

# --- Почта: сброс пароля напрямую; ревью/жалобы через очередь ---
# При false сброс пароля пишет токен в dev-лог, outbox ждёт включения SMTP.
APP_MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
APP_MAIL_FROM=noreply@analystgym.ru

# --- Лимиты API (по умолчанию хватает; крутить при абузе) ---
RATELIMIT_LOGIN_PER_MIN=20
RATELIMIT_REGISTER_PER_MIN=5
RATELIMIT_RESET_PER_MIN=5
RATELIMIT_SUBMIT_PER_MIN=10
RATELIMIT_ASSESSMENT_PER_MIN=5
RATELIMIT_COMPLAINTS_PER_MIN=10
