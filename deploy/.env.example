# Пример окружения. Скопировать в deploy/.env и заполнить настоящими значениями.
# Сам .env в git не коммитим (см. .gitignore). Пароль и секрет сгенерировать, не "12345".
POSTGRES_USER=analystgym
POSTGRES_PASSWORD=change-me-before-prod

# JWT-секрет: минимум 32 символа, сгенерировать один раз и не ротировать без нужды
# (ротация вышибает все сессии). Генерация: openssl rand -hex 32.
APP_JWT_SECRET=change-me-to-32-plus-chars-secret-before-prod
