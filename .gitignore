# Production runs: трекаем все каталоги, иначе после clone регены пропадут
# (раньше был точечный whitelist — из‑за него потерялись M03/M04).
runs/*
!runs/.gitkeep
!runs/*/
!runs/*/**

# Lesson packages в output/
output/*
!output/.gitkeep

node_modules/
# Локальные настройки IntelliJ IDEA во всех каталогах проекта
.idea/
.DS_Store
compliance_project_example/
# AnalystGym backend: сборочный мусор и сгенерированная статика
analystgym/backend/.gradle/
analystgym/backend/**/build/
analystgym/backend/app/src/main/resources/static/

